# ============ Telegram (required for notifications) ============
# 1. Message @BotFather on Telegram -> /newbot -> copy the token
# 2. Send your new bot any message, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates   -> copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============ LLM scoring (free) ============
# gemini (default) | ollama | none
LLM_BACKEND=gemini
# Free key: https://aistudio.google.com -> Get API key (no credit card)
GEMINI_API_KEY=
# Only if LLM_BACKEND=ollama:
#OLLAMA_URL=http://localhost:11434
#OLLAMA_MODEL=qwen2.5:7b

# ============ Reddit (free) ============
# https://www.reddit.com/prefs/apps -> create app -> type "script"
# personal use script id = client id; secret = client secret
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Only for AUTO-REPLY (posting DMs/comments). Account 2FA must be off for the
# script-app password grant to work.
#REDDIT_USERNAME=
#REDDIT_PASSWORD=
#REDDIT_REPLY_VIA=dm

# ============ Auto-reply (off by default) ============
# When on: leads scoring >= REPLY_MIN_SCORE on Reddit/Freelancer get an
# LLM-drafted reply per your REPLY_DIRECTION. approve = you confirm each send
# (python main.py --replies / --approve-reply N). Switch to auto only after
# reviewing a few batches of drafts.
REPLY_ENABLED=0
#REPLY_MODE=approve
#REPLY_MIN_SCORE=8
#REPLY_DAILY_CAP=8
#REPLY_DIRECTION=Reply only to genuine freelance/contract CV/OCR/ML/algorithms leads...

# ============ Freelancer.com bidding (free token) ============
# https://developers.freelancer.com -> log in with your Freelancer account ->
# create app / generate token. NOTE: placing bids counts against your monthly
# free bid quota like manual bids - the daily cap protects it.
#FREELANCER_OAUTH_TOKEN=
#FREELANCER_BID_STRATEGY=mid
#FREELANCER_BID_PERIOD_DAYS=7

# ============ Gmail IMAP (Facebook / Upwork / Wellfound / LinkedIn alerts) ============
# Google account -> Security -> 2-Step Verification -> App passwords
# (this is NOT your normal password)
# LinkedIn: create saved-search job alerts (README section 5) - this is the
# reliable half of the LinkedIn integration; the guest scraper is best-effort.
IMAP_USER=
IMAP_PASSWORD=
#IMAP_FOLDER=INBOX
#IMAP_LOOKBACK_DAYS=3

# ============ LinkedIn guest scraper (no account, no key) ============
# Logged-out endpoints; nothing to configure. LinkedIn's guest filters are
# unreliable, so most of each run is gated out as full-time - that is expected.
# Descriptions cost one request each; raise only if you see the cap logged often.
#LINKEDIN_DETAIL_CAP=15

# ============ Facebook PUBLIC-group scraper (optional, off by default) ============
# Zero account risk (never logs in) but scrapes only PUBLIC groups.
# Requires: pip install playwright && playwright install chromium
# Leave at 0 to rely purely on Facebook notification emails.
#
# IMPORTANT: run this in the CLOUD (GitHub Actions — see SETUP_CLOUD.md), not on
# the machine you browse Facebook from. The scraper trips Meta's per-IP rate
# limit; on your home IP that surfaces a login/checkpoint wall on YOUR account.
# On a GitHub runner the throttle hits a disposable IP and your account is safe.
FB_PUBLIC_ENABLED=0
#FB_REGIONS=IL,US,EU        # which regions' public groups to scrape (EU incl. UK); empty = all
#FB_GROUPS_PER_RUN=6        # rotate through this many groups per run (0 = all). Keeps each run gentle.
#FB_GROUP_GAP_SECONDS=90    # pause between groups (higher = safer). Local default is 20.
#FB_POSTS_PER_GROUP=12
#FB_MAX_RUNS_PER_DAY=3      # local safety cap on runs/day
#FB_IGNORE_DAILY_CAP=0      # cloud workflow sets =1 (cron controls cadence instead)

# ============ Routing (optional overrides) ============
#PUSH_THRESHOLD=8
#DIGEST_THRESHOLD=6
#DIGEST_HOUR=18
# Auto-draft a copy-paste first-contact reply on pushed leads (Gemini; on by default)
#PITCH_DRAFTS=1

# ============ Extra free LLM providers (optional, recommended) ============
# Gemini's free tier is ~20 calls/day. These are all OpenAI-compatible and the
# scorer walks them in order, so adding any one of them multiplies capacity.
# Each is free and needs no credit card.
#
# openrouter.ai/keys  - the strongest free models found (nvidia nemotron-3-ultra
#                       550b @ 1M context, gemma-4-31b). Best single addition.
#OPENROUTER_API_KEY=
#OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# console.groq.com/keys - smaller models, very fast, generous daily allowance
#GROQ_API_KEY=
# cloud.cerebras.ai   - another independent free quota
#CEREBRAS_API_KEY=
